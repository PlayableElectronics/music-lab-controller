#!/bin/sh
set -u

CLIENT=/usr/local/lib/music-lab/lab-client

host_status() {
    printf 'Music Lab Controller\n\nHOST\n'
    printf '  hostname      '; hostname 2>/dev/null || printf 'unavailable\n'
    printf '  kernel        '; uname -a 2>/dev/null || printf 'unavailable\n'
    printf '  architecture  '; uname -m 2>/dev/null || printf 'unavailable\n'
    printf '  uptime        '
    if [ -r /proc/uptime ]; then awk '{ print $1 " seconds" }' /proc/uptime; else uptime 2>/dev/null || printf 'unavailable\n'; fi
    printf '  memory total  '
    if [ -r /proc/meminfo ]; then awk '$1 == "MemTotal:" { print $2 " " $3; exit }' /proc/meminfo; else printf 'unavailable\n'; fi
    printf '  memory free   '
    if [ -r /proc/meminfo ]; then awk '$1 == "MemFree:" { print $2 " " $3; exit }' /proc/meminfo; else printf 'unavailable\n'; fi
    printf '  ip            \n'
    if command -v ip >/dev/null 2>&1; then ip -4 addr 2>/dev/null | awk '/inet / { sub(/\/.*$/, "", $2); print "  " $2 }'; else printf '  unavailable\n'; fi
}

if [ "${1:-}" = host-status ]; then
    host_status
elif [ -x "$CLIENT" ]; then
    exec "$CLIENT" "$@"
else
    [ "${1:-}" = status ] && host_status && exit 0
    printf 'lab: labd client is not installed\n' >&2
    exit 1
fi
