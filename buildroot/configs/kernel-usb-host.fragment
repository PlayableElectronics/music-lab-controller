# USB host support for the original 64 MB Duo.
# DWC2 is already built in by the official Duo defconfig.
CONFIG_USB_DWC2=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_RTL8152=y
